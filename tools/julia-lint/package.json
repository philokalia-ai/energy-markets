{
  "name": "energy-markets-julia-lint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.3"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "eslint-plugin-julia": "0.3.1",
    "prettier": "3.9.10",
    "prettier-plugin-julia": "0.2.1"
  },
  "scripts": {
    "lint": "cd ../.. && eslint -c tools/julia-lint/eslint.config.js \"**/*.jl\"",
    "format:check": "prettier --config .prettierrc.json --check \"../../**/*.jl\"",
    "format": "prettier --config .prettierrc.json --write \"../../**/*.jl\""
  }
}
