// Παρουσίαση διπλωματικής — Μοντελοποίηση Αγορών Ηλεκτρικής Ενέργειας με Julia/JuMP
// Μετάφραση σε PDF: typst compile slides.typ  (χωρίς εξωτερικά πακέτα)

#let accent = rgb("#1f77b4")
#let accent2 = rgb("#ff7f0e")
#let dark = rgb("#1a1a2e")

#set page(width: 25.4cm, height: 14.29cm, margin: (x: 1.5cm, y: 1.0cm))
#set text(font: ("Liberation Sans", "DejaVu Sans"), size: 15.5pt, lang: "el")
#set list(marker: text(accent, "▸"))

#let slide-count = counter("slide")

#let slide(title: none, body) = {
  slide-count.step()
  page({
    if title != none {
      block(below: 0.5cm)[
        #text(size: 22pt, weight: "bold", fill: dark)[#title]
        #v(-0.35cm)
        #line(length: 100%, stroke: 2pt + accent)
      ]
    }
    body
    place(bottom + right, dy: 0.5cm)[
      #text(size: 10pt, fill: gray)[#context slide-count.display() / 27]
    ]
  })
}

