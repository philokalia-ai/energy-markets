{
  "name": "euphemia-api",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker serving the euphemia-web-data R2 parquet as the JSON shapes web/app.js consumes (issue #152)",
  "type": "module",
  "scripts": {
    "test": "node test/shape.test.mjs",
    "test:book": "node test/book.test.mjs",
    "test:units": "node test/units.test.mjs",
    "test:flows": "node test/flows.test.mjs",
    "test:table": "node test/book_table.test.mjs",
    "test:ladder": "node test/book_ladder.test.mjs",
    "test:solver": "node test/solver_toy.test.mjs",
    "test:inputs-routes": "node test/inputs_routes.test.mjs",
    "test:predict": "node test/predict.test.mjs",
    "test:views": "node test/views_empty_state.test.mjs",
    "test:track": "node test/one_track.test.mjs",
    "test:methodology": "node test/book_methodology.test.mjs",
    "test:methodview": "node test/method_view.test.mjs",
    "test:boundaries": "node test/boundaries.test.mjs",
    "test:boundaryview": "node test/boundary_view.test.mjs",
    "dev": "wrangler dev --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
    "test:overlay": "node test/tsfm_overlay.test.mjs",
    "test:q15": "node test/q15_scores.test.mjs",
    "test:q15route": "node test/q15_board_route.test.mjs",
    "test:naive": "node test/naive_board.test.mjs",
    "test:latestonly": "node test/latest_only.test.mjs",
    "test:backfill": "node test/backfill_window.test.mjs",
    "test:tsfmbackfill": "node test/tsfm_backfill_fields.test.mjs"
  },
  "dependencies": {
    "hyparquet": "^1.26.2",
    "hyparquet-compressors": "^1.1.1"
  },
  "devDependencies": {
    "wrangler": "^4.131.1"
  },
  "overrides": {
    "undici": ">=7.29.0"
  }
}
